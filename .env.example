# Copy this file to .env and fill in your own key.
# Never commit a real API key.

# Preferred generic OpenAI-compatible variables.
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini

# Leave empty for official OpenAI. Fill for compatible providers.
# Examples:
# DeepSeek: https://api.deepseek.com
# DashScope OpenAI-compatible: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# Alibaba Cloud DeepSeek V4 hybrid models: default false for bounded, faster drafts.
# Set true only if you intentionally want thinking mode (uses output budget).
LLM_ENABLE_THINKING=false

# Legacy variable names are also supported:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

# Web demo: leave public real-time AI disabled until provider spend limits are set.
AI_BUDGET_CONFIRMED=0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUOTA_HASH_SECRET=
